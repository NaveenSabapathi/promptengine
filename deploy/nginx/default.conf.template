# TLS terminates here. The only upstream is a non-public Docker service.
resolver 127.0.0.11 valid=10s ipv6=off;
server {
    listen 8080 default_server;
    server_name _;
    location = /nginx-health { access_log off; return 200 'ok'; }
    location / { return 308 https://${PUBLIC_DOMAIN}$request_uri; }
}
server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
}
server {
    listen 8443 ssl;
    http2 on;
    server_name ${PUBLIC_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    root /usr/share/nginx/html;
    index index.html;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    location = /api { return 404; }
    location ^~ /api/ {
        set $api http://api:8000;
        proxy_pass $api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host ${PUBLIC_DOMAIN};
        # Overwrite incoming forwarding headers; never append client input.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host '';
        proxy_set_header Forwarded '';
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
        proxy_next_upstream off;
        proxy_cache off;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        # Parent security headers remain inherited; expires adds cache headers.
    }
    location ~ /\. { return 404; }
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
