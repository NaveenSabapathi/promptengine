# Copy to .env; Flask reads it only if explicitly exported or loaded by your runner.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://promptengine:change-me@localhost:5432/promptengine
# Generate each independently: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
JWT_SECRET_KEY=
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:5000
TRUST_PROXY=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common: work/school + personal; organizations: work/school; consumers: personal; or tenant UUID.
MICROSOFT_TENANT=common

# AI refinement is optional; /api/compile works without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
