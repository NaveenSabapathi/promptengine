{
  "name": "@promptengine/extension",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "@playwright/test": "^1.63.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
